    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/tar-stream": "^3.1.3",
    "@types/ws": "8.18.1",
