# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agentforall
# 64 hex chars (256-bit). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
# JSON object mapping API key → user id. Used by CLI / direct integrators who
# call the orchestrator as a single user.
#   Example: {"aaaa...32chars...":"user-cli"}
API_KEYS={}

# Comma-separated list of trusted service tokens. These let a server caller
# (e.g. the Next.js dashboard) impersonate any user via the X-Act-As-User
# header. Standard PaaS impersonation pattern; each token must be 32+ chars.
# Generate with: openssl rand -hex 32
SERVICE_TOKENS=

# ── HTTP server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
TRUST_PROXY=true

# ── Host scoping ────────────────────────────────────────────────────────────
# Stable identifier for this orchestrator process. Reconciler + health monitor
# only operate on rows stamped with this id, so multiple orchestrators (multi-
# host prod, blue/green, local dev) can share one DB without stomping each
# other. Lowercase alphanumeric + dashes, 1–64 chars. Required.
ORCHESTRATOR_HOST_ID=

# ── Docker ──────────────────────────────────────────────────────────────────
AGENT_RUNTIME_KIND=openclaw
AGENT_RUNTIME_IMAGE=europe-west4-docker.pkg.dev/agent-for-all/agent-forall/openclaw-browser@sha256:13f281ec9c8452b1f50d554edd1d2f6879195ecc956a463c99f01a79303a71bc
HERMES_RUNTIME_IMAGE=nousresearch/hermes-agent@sha256:b6e41c155d6bfce5ad83c5d0fec670086db8a43250e4511c9474134be5482d33
PULL_IMAGES_ON_STARTUP=true
# Leave DOCKER_HOST / DOCKER_SOCKET_PATH unset to use the default socket.
# DOCKER_HOST=
# DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=tenant-net

# Host-port range allocated to tenant gateway containers. Bound to 127.0.0.1.
PORT_RANGE_START=19000
PORT_RANGE_END=19999

# ── Health monitoring ───────────────────────────────────────────────────────
HEALTH_POLL_INTERVAL_MS=15000
HEALTH_DEGRADED_THRESHOLD=3
HEALTH_UNHEALTHY_THRESHOLD=5
HEALTH_REQUEST_TIMEOUT_MS=5000
HEALTH_MAX_CONCURRENT_CHECKS=10

# ── Lifecycle ───────────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000
RECONCILE_ON_STARTUP=true
RECONCILE_INTERVAL_MS=60000
RUN_MIGRATIONS_ON_STARTUP=false
MAX_PROVISION_RETRIES=3
MAX_INSTANCES_PER_USER=1
BACKUP_IMPORT_BUCKET=agent-forall-backup-imports
BACKUP_IMPORT_UPLOAD_ORIGIN=https://agentforall.co.il
BACKUP_IMPORT_TTL_SECONDS=3600

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Telegram managed-bot linking ────────────────────────────────────────────
# Token of the platform's manager bot (BotFather bot with Bot Management Mode).
# Leave empty to disable Telegram linking. Only one host may poll this token.
TELEGRAM_MANAGER_BOT_TOKEN=

# ── WhatsApp pairing sidecar ────────────────────────────────────────────────
PAIRING_IMAGE=europe-west4-docker.pkg.dev/agent-for-all/agent-forall/whatsapp-pairing@sha256:20b44400bee9b7ea9c5e233d9dfc779434922b92fd9b9a9dc444ae8054544a57
PAIRING_PORT=18790
PAIRING_IDLE_TIMEOUT_MS=600000
PAIRING_REQUEST_TIMEOUT_MS=5000
PAIRING_STALE_THRESHOLD_MS=900000
PAIRING_LOG_LEVEL=info

# URL the pairing sidecar uses to call back to this orchestrator. Inside the
# tenant-net docker network, refer to the orchestrator by container
# name (e.g. http://agent-forall:3000).
ORCHESTRATOR_INTERNAL_URL=http://orchestrator:3000

# Default LLM provider — applied when a create-bot request omits `provider`.
DEFAULT_PROVIDER_NAME=anthropic
DEFAULT_PROVIDER_ID=
DEFAULT_PROVIDER_API_KEY=
DEFAULT_PROVIDER_MODEL=claude-opus-4-7
DEFAULT_PROVIDER_BASE_URL=
DEFAULT_PROVIDER_INPUT=text
DEFAULT_PROVIDER_MEDIA=
LITELLM_MASTER_KEY=
# Standalone mode (BILLING_REQUIRED off on the web): every key gets this budget, reset by LiteLLM every 30 days.
# Ledger mode (BILLING_REQUIRED on): set CENTS=200 (a fresh key holds the trial's $2 until the web pushes the
# real cap) and DURATION empty (never reset gateway-side; the web ledger owns budgets).
LITELLM_DEFAULT_BUDGET_CENTS=5000
LITELLM_DEFAULT_BUDGET_DURATION=30d

# Integrations (third-party app connections via the orchestrator's MCP relay).
# Unset = disabled. `mock` is dev-only; `composio` needs COMPOSIO_API_KEY.
INTEGRATIONS_PROVIDER=
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
# Only origin OAuth flows may return to. Dev: http://localhost:3000
DASHBOARD_ORIGIN=https://agentforall.co.il
