DATABASE_URL="postgresql://user:password@localhost:5432/agentforall"
NEXT_PUBLIC_META_PIXEL_ID=803144279101703
# Comma-separated verified emails allowed into /admin (role, not a shared password).
ADMIN_EMAILS=agentforall.il@gmail.com

# Meta Conversions API — server-side event forwarding for the Pixel.
# Generate in Events Manager → Data Sources → <Pixel> → Settings → "Generate access token".
# Leave unset in dev if you don't want events sent; the Pixel still works client-side.
META_CAPI_ACCESS_TOKEN=
# Optional: when set, events show up only in Events Manager → Test Events
# under this code. Never set in production.
META_CAPI_TEST_EVENT_CODE=
# Optional: pin a specific Graph API version (defaults to v22.0).
META_CAPI_API_VERSION=
# WhatsApp Business (Meta Cloud API). All four required to enable the channel; the app id and
# Embedded Signup config id are public, the secret and verify token are not.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
# "true" shows the WhatsApp Business row and allows connects; the webhook works without it.
WHATSAPP_CLOUD_ENABLED=
# While the switch is off, these user ids (comma-separated) still see the channel, for rehearsal.
WHATSAPP_CLOUD_PREVIEW_USER_IDS=

# ── Better Auth ─────────────────────────────────────────────────────────────
# Random 32+ byte secret used to sign session cookies.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL the app is reachable at. Must match the Google OAuth redirect URI
# (see below) host: ${BETTER_AUTH_URL}/api/auth/callback/google
# Local dev: http://localhost:3000   Prod: https://agentforall.co.il
BETTER_AUTH_URL=http://localhost:3000

# Optional: used by the client so it knows the origin for API calls.
# In single-host deployments this equals BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 client credentials.
# Create in: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend send-only key for verification and password-reset emails, sent from
# no-reply@agentforall.co.il (the domain must be verified in Resend).
RESEND_API_KEY=

# Cloudflare Turnstile guarding email sign-up, sign-in and reset. The values
# below are Cloudflare's always-pass test keys; production uses the real pair.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Orchestrator (server-side calls from Next.js) ───────────────────────────
# Base URL of the agent orchestrator. In prod this is typically
# https://orchestrator.agentforall.co.il (behind Caddy + TLS). In local dev
# the orchestrator runs on a local Docker daemon on a different port.
ORCHESTRATOR_BASE_URL=http://localhost:3001

# Trusted service token for server-to-server auth. Must match one of the
# tokens listed in the orchestrator's SERVICE_TOKENS env var. 32+ chars.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_SERVICE_TOKEN=

# ── eSIM partner ────────────────────────────────────────────────────────────
# Optional affiliate link shown in the pairing flow. Leave blank to hide the card.
NEXT_PUBLIC_ESIM_PARTNER_URL=

# ── Billing ─────────────────────────────────────────────────────────────────
# Which payment adapter receives new checkouts: `mock` (local only) or `paddle`.
# Unset = billing disabled (status reads work, money paths return 503).
PAYMENT_PROVIDER=mock
# Mock gateway only (refused when NODE_ENV=production). Signs the simulated
# callbacks so the real webhook verification path is exercised locally.
# Generate with: openssl rand -hex 32
MOCK_PAYMENT_WEBHOOK_SECRET=
# Paddle (merchant of record). `sandbox` or `production`; keys must match it.
PADDLE_ENVIRONMENT=
# Developer tools > Authentication: server API key (secret) and client-side token (public).
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# Developer tools > Notifications: destination https://<app>/api/billing/webhooks/paddle, its secret key.
PADDLE_WEBHOOK_SECRET=
# Printed by `npm run -w @agent-forall/web paddle:catalog`: plan code -> pri_ id JSON, and the top-up product.
PADDLE_PRICE_IDS=
PADDLE_TOPUP_PRODUCT_ID=
# true = creating a bot requires an entitled subscription (or beta_access).
# false (default) = payments are recorded but never block the product.
BILLING_REQUIRED=false
# Protects /api/billing/cron/sync (Vercel sets the matching Authorization header
# on cron invocations). Generate with: openssl rand -hex 32
CRON_SECRET=
