# PostgreSQL (used by docker-compose for postgres container)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ──────────────────────────────────────────────
# Landing page (apps/web)
# ──────────────────────────────────────────────
# DATABASE_URL=postgresql://...
# NEXT_PUBLIC_META_PIXEL_ID=803144279101703
# ADMIN_PASSWORD=<strong-random-password>
# META_CAPI_ACCESS_TOKEN=<from Events Manager → Pixel → Settings → Generate access token>
# META_CAPI_TEST_EVENT_CODE=<optional, for Events Manager → Test Events>
# META_CAPI_API_VERSION=<optional, defaults to v22.0>

# ──────────────────────────────────────────────
# Below values go in .env.runtime (loaded by app via env_file)
# ──────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=<64 hex chars>

# JSON map: {"bearer-token": "user-id"}
# Generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEYS={"your-token-here":"user-1"}

# AGENT_RUNTIME_KIND=openclaw
# AGENT_RUNTIME_IMAGE=europe-west4-docker.pkg.dev/agent-for-all/agent-forall/openclaw-browser@sha256:13f281ec9c8452b1f50d554edd1d2f6879195ecc956a463c99f01a79303a71bc
# HERMES_RUNTIME_IMAGE=nousresearch/hermes-agent@sha256:b6e41c155d6bfce5ad83c5d0fec670086db8a43250e4511c9474134be5482d33
# PULL_IMAGES_ON_STARTUP=true
# PORT_RANGE_START=19000
# PORT_RANGE_END=19999
# MAX_INSTANCES_PER_USER=1
# BACKUP_IMPORT_BUCKET=agent-forall-backup-imports
# BACKUP_IMPORT_UPLOAD_ORIGIN=https://agentforall.co.il
# BACKUP_IMPORT_TTL_SECONDS=3600
# Manager bot token for Telegram managed-bot linking (empty = feature off)
# TELEGRAM_MANAGER_BOT_TOKEN=<token of the platform's BotFather manager bot>
# LITELLM_MASTER_KEY=<master key used only by orchestrator>
# LITELLM_DEFAULT_BUDGET_CENTS=5000
# LITELLM_DEFAULT_BUDGET_DURATION=30d
