*filter
:DOCKER-USER - [0:0]
-A DOCKER-USER -p udp --dport 53 -d 169.254.169.254 -j RETURN
-A DOCKER-USER -p tcp --dport 53 -d 169.254.169.254 -j RETURN
-A DOCKER-USER -d 169.254.169.254 -j DROP
-A DOCKER-USER -j RETURN
:AF-TENANT - [0:0]
-A AF-TENANT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A AF-TENANT -j DROP
-I INPUT -i ${tenant_bridge} -j AF-TENANT
COMMIT
